# Copy to backend/.env and fill in real values. Never commit the real .env file.

# --- xAI Grok (via LangChain's ChatXAI) -------------------------------------
# Get a key at https://console.x.ai — keep it on the backend ONLY.
XAI_API_KEY=your_xai_api_key
# A real, current Grok model name, e.g. grok-4, grok-3-latest, or grok-beta.
# See app/ai/model.py for an important note if you actually intended to use
# Groq-hosted gpt-oss-120b instead of xAI's Grok — they are different
# providers despite the similar name.
XAI_MODEL=openai/gpt-oss-20b

# --- Database ----------------------------------------------------------
# Same Neon Postgres database the Next.js frontend's Drizzle setup uses —
# use the POOLED connection string from the Neon dashboard.
DATABASE_URL=DATABASE_URL

# --- CORS ----------------------------------------------------------------
# The exact origin of the deployed (or local) Next.js frontend. Never "*".
FRONTEND_ORIGIN=http://localhost:3000

# --- Request limits (optional — sane defaults are already set in config.py)
MAX_MESSAGE_LENGTH=4000
MAX_HISTORY_MESSAGES=50
CHAT_RATE_LIMIT=200/minute

# --- Misc ------------------------------------------------------------------
# "development" enables interactive API docs at /docs; "production" disables them.
ENVIRONMENT=development
