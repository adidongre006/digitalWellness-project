# Copy to .env.local and fill in real values. Never commit the real .env.local file.

# --- Database ------------------------------------------------------------
# Neon Postgres POOLED connection string (hostname contains "-pooler"),
# from your Neon project dashboard → Connection Details.
DATABASE_URL=your_neon_postgresql_connection_string

# --- App URLs --------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only (no NEXT_PUBLIC_ prefix): the FastAPI backend's base URL.
# Used exclusively by src/app/api/chat/route.ts to proxy chat streaming —
# never sent to the browser, so the backend's real location stays private.
FASTAPI_BACKEND_URL=http://localhost:8000

# --- Admin setup -----------------------------------------------------------
# A private, random secret ONLY you know. Required once, to create the first
# administrator account at /admin. Generate one with, e.g.:
#   openssl rand -base64 32
# Rotate or remove it from your deployment's env vars after the first admin
# account exists — the setup endpoint refuses to run a second time regardless,
# but removing the secret afterward is good hygiene.
ADMIN_INITIAL_SETUP_SECRET=your_private_initial_setup_secret
